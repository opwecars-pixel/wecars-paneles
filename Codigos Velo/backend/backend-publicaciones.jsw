  //     externalPostId = await _publicarInstagram(cuenta, pub.texto, fotoUrls, token);
  //   } else if (cuenta.plataforma === 'facebook') {
  //     externalPostId = await _publicarFacebook(cuenta, pub.texto, fotoUrls[0], token);
  //   } else {
  //     throw new Error(`Plataforma no soportada: ${cuenta.plataforma}`);
  //   }
  //
  //   await wixData.update('Publicaciones', {
  //     _id: publicacionId,
  //     estado: 'publicada',
  //     externalPostId,
  //     fechaPublicacion: new Date(),
  //     errorMensaje: '',
  //   }, SA);
  //
  //   return { ok: true, estado: 'publicada', plataforma: cuenta.plataforma, externalPostId };
  // } catch (err) {
  //   await wixData.update('Publicaciones', {
  //     _id: publicacionId,
  //     estado: 'error',
  //     errorMensaje: err.message || 'Error desconocido al publicar.',
  //   }, SA);
  //   return { ok: false, error: err.message || 'Error al publicar en Meta.' };
  // }
  // ── FIN FASE 5 ────────────────────────────────────────────────────────────

  // FASE 1: simulación mientras Meta no está configurado
  return {
    ok: false,
    pendiente: true,
    mensaje: 'Integración con Meta pendiente de configuración. El borrador fue guardado y se publicará cuando el administrador conecte la cuenta.',
  };
}

// ── META GRAPH API: funciones internas (FASE 5) ───────────────────

async function _publicarInstagram(cuenta, texto, fotoUrls, token) {
  const actorId = cuenta.instagramActorId || cuenta.paginaId;

  // Paso 1: crear media container
  const body1 = new URLSearchParams({
    image_url: fotoUrls[0],
    caption: texto,
    access_token: token,
  });
  const res1 = await fetch(
    `https://graph.facebook.com/v18.0/${actorId}/media`,
    { method: 'POST', body: body1 }
  );
  const data1 = await res1.json();
  if (data1.error) throw new Error(`Meta error: ${data1.error.message}`);

  // Paso 2: publicar el container
  const body2 = new URLSearchParams({
    creation_id: data1.id,
    access_token: token,
  });
  const res2 = await fetch(
    `https://graph.facebook.com/v18.0/${actorId}/media_publish`,
    { method: 'POST', body: body2 }
  );
  const data2 = await res2.json();
  if (data2.error) throw new Error(`Meta error al publicar: ${data2.error.message}`);

  return data2.id;
}

async function _publicarFacebook(cuenta, texto, fotoUrl, token) {
  const body = new URLSearchParams({
    url: fotoUrl,
    caption: texto,
    access_token: token,
  });
  const res = await fetch(
    `https://graph.facebook.com/v18.0/${cuenta.paginaId}/photos`,
    { method: 'POST', body }
  );
  const data = await res.json();
  if (data.error) throw new Error(`Meta error: ${data.error.message}`);
  return data.post_id || data.id;
}

// ── HISTORIAL ─────────────────────────────────────────────────────

/**
 * Devuelve el historial de publicaciones.
 * filtros: { estado?, plataforma?, desde?, hasta? }
 * Vendedor → solo sus publicaciones.
 * Gerencia/Administración → todas.
 */
export async function obtenerHistorial(filtros) {
  const { email, rol } = await _requireIdentidad();
  const f = filtros || {};

  let query = wixData.query('Publicaciones').descending('fechaCreacion').limit(100);

  if (!_ROLES_GERENCIA_NORM.has(normalizarRol(rol))) {
    query = query.eq('vendedorEmail', email);
  }
  if (f.estado) query = query.eq('estado', f.estado);
  if (f.plataforma) query = query.eq('plataforma', f.plataforma);
  if (f.desde) query = query.ge('fechaCreacion', new Date(f.desde));
  if (f.hasta) query = query.le('fechaCreacion', new Date(f.hasta));

  const res = await query.find(SA);
  return res.items.map(p => ({
    _id: p._id,
    carroId: p.carroId,
    carroSlug: p.carroSlug,
    vendedorEmail: p.vendedorEmail,
    plataforma: p.plataforma,
    texto: p.texto,
    fotoUrls: _parseJson(p.fotoUrls, []),
    estado: p.estado,
    fechaCreacion: p.fechaCreacion,
    fechaPublicacion: p.fechaPublicacion,
    externalPostId: p.externalPostId || null,
    errorMensaje: p.errorMensaje || null,
    // cuentaSocialId NO se expone al frontend
  }));
}

// ── ADMINISTRACIÓN DE CUENTAS (solo rol Administración) ───────────

/**
 * Conectar nueva cuenta social. Llamado desde http-functions.js/meta_oauth_callback.
 * datos: { propietarioEmail, tipo, plataforma, paginaId, paginaNombre,
 *          instagramActorId?, secretKey }
 * El token ya fue intercambiado por el callback y guardado en Wix Secrets
 * antes de llamar esta función. Aquí solo guardamos la metadata.
 */
export async function conectarCuenta(datos) {
  const { rol } = await _requireIdentidad();
  if (!_ROLES_ADMIN_NORM.has(normalizarRol(rol))) throw new Error('Solo Administración puede conectar cuentas.');

  if (!datos.paginaId || !datos.secretKey || !datos.plataforma) {
    throw new Error('Faltan datos requeridos para conectar la cuenta.');
  }

  const registro = {
    propietarioEmail: (datos.propietarioEmail || '').toLowerCase().trim(),
    tipo: datos.tipo || 'corporativa',
    plataforma: datos.plataforma,
    paginaId: datos.paginaId,
    paginaNombre: datos.paginaNombre || datos.paginaId,
    instagramActorId: datos.instagramActorId || '',
    estado: 'activa',
    vendedoresAutorizados: datos.vendedoresAutorizados || '[]',
    secretKey: datos.secretKey,
    fechaConexion: new Date(),
    ultimoError: '',
  };

  return wixData.insert('CuentasSociales', registro, SA)
    .then(r => ({ ok: true, _id: r._id, paginaNombre: r.paginaNombre }));
}

/**
 * Marcar cuenta como desconectada (no elimina el registro ni las publicaciones).
 */
export async function desconectarCuenta(cuentaId) {
  const { rol } = await _requireIdentidad();
  if (!_ROLES_ADMIN_NORM.has(normalizarRol(rol))) throw new Error('Solo Administración puede desconectar cuentas.');

  const cuenta = await wixData.get('CuentasSociales', cuentaId, SA);
  if (!cuenta) throw new Error('Cuenta no encontrada.');

  return wixData.update('CuentasSociales', {
    _id: cuentaId,
    estado: 'desconectada',
  }, SA).then(() => ({ ok: true }));
}

/**
 * Actualizar lista de vendedores autorizados para una cuenta corporativa.
 * emails: array de emails de vendedores
 */
export async function actualizarAutorizados(cuentaId, emails) {
  const { rol } = await _requireIdentidad();
  if (!_ROLES_ADMIN_NORM.has(normalizarRol(rol))) throw new Error('Solo Administración puede gestionar permisos.');

  const cuenta = await wixData.get('CuentasSociales', cuentaId, SA);
  if (!cuenta) throw new Error('Cuenta no encontrada.');
  if (cuenta.tipo !== 'corporativa') throw new Error('Solo las cuentas corporativas tienen vendedores autorizados.');

  const lista = Array.isArray(emails)
    ? emails.map(e => String(e).toLowerCase().trim()).filter(Boolean)
    : [];

  return wixData.update('CuentasSociales', {
    _id: cuentaId,
    vendedoresAutorizados: JSON.stringify(lista),
  }, SA).then(() => ({ ok: true, autorizados: lista.length }));
}

/**
 * Devuelve todas las cuentas sociales (para el panel de Administración).
 * Incluye estado, no incluye secretKey.
 */
export async function obtenerTodasLasCuentas() {
  const { rol } = await _requireIdentidad();
  if (!_ROLES_GERENCIA_NORM.has(normalizarRol(rol))) {
    throw new Error('Acceso no autorizado.');
  }

  const res = await wixData.query('CuentasSociales')
    .descending('fechaConexion')
    .limit(100)
    .find(SA);

  return res.items.map(c => ({
    _id: c._id,
    propietarioEmail: c.propietarioEmail,
    tipo: c.tipo,
    plataforma: c.plataforma,
    paginaNombre: c.paginaNombre,
    estado: c.estado,
    vendedoresAutorizados: _parseJson(c.vendedoresAutorizados, []),
    fechaConexion: c.fechaConexion,
    ultimoError: c.ultimoError || '',
    // secretKey NUNCA se devuelve al frontend
  }));
}

// ── TRIGGER: auto vendido → archivar publicaciones ───────────────

/**
 * Marca como 'archivada' todas las publicaciones activas de un vehículo.
 * Llamar desde backend-flujo.js al cerrar una venta.
 * No requiere autenticación de usuario — es llamada server-to-server.
 */
export async function desactivarPublicacionesDeAuto(carroId) {
  if (!carroId) return { ok: false, error: 'carroId requerido' };

  const res = await wixData.query('Publicaciones')
    .eq('carroId', carroId)
    .eq('estado', 'publicada')
    .find(SA);

  if (!res.items.length) return { ok: true, archivadas: 0 };

  await Promise.all(
    res.items.map(p =>
      wixData.update('Publicaciones', { _id: p._id, estado: 'archivada' }, SA)
    )
  );

  return { ok: true, archivadas: res.items.length };
}

// ── GENERACIÓN DE TEXTO (helper exportado para el frontend) ───────

/**
 * Genera texto de publicación basado en datos del vehículo.
 * No llama a ninguna API — es lógica local pura.
 * carro: objeto del inventario. plataforma: 'instagram' | 'facebook'
 */
export async function generarTexto(carro, plataforma) {
  await _requireIdentidad(); // solo usuarios autenticados
  return _generarTextoLocal(carro, plataforma);
}

function _generarTextoLocal(carro, plataforma) {
  const precio = (carro.precio || 0).toLocaleString('es-MX', {
    style: 'currency', currency: 'MXN', maximumFractionDigits: 0,
  });
  const km = (carro.km || 0).toLocaleString('es-MX');
  const detalles = [carro.transmision, carro.combustible].filter(Boolean).join(' · ');

  let texto = `🚗 ${carro.marca} ${carro.modelo} ${carro.año}`;
  if (carro.version) texto += ` ${carro.version}`;
  texto += `\n${km} km · ${precio}`;
  if (detalles) texto += `\n${detalles}`;
  if (carro.color) texto += ` · ${carro.color}`;
  texto += '\n';
  if (carro.descripcion) texto += `\n${carro.descripcion.trim()}\n`;
  texto += '\n📍 weCars Bajío — Celaya, Gto.\n📲 Escríbenos por DM o WhatsApp para más información';
  if (plataforma === 'instagram') {
    texto += '\n\n#weCars #weCarsAutos #SeminuevosCelaya #AutosCelaya #Bajío #SeminuevosGuanajuato';
  }
  return texto;
}
