// backend/gerencia-data.jsw
// Panel Gerencia — vista completa de todas las colecciones
import wixData  from 'wix-data';
import wixUsers from 'wix-users-backend';

const OPTS = { suppressAuth: true };
const ROLES_GERENCIA = ['gerencia', 'administracion'];

async function verificarAcceso() {
  try {
    const user = wixUsers.currentUser;
    if (!user.loggedIn) return; // en preview puede no haber sesión
    const roles = await user.getRoles();
    const nombres = roles.map(r => (r.name || '').toLowerCase());
    if (!ROLES_GERENCIA.some(r => nombres.includes(r)))
      throw new Error('Sin permiso para acceder a datos de Gerencia');
  } catch (e) {
    // "Identity not found" en editor/preview — permitir carga de datos
    if (e.message && e.message.includes('Identity not found')) return;
    throw e;
  }
}

async function safeQuery(coleccion, limite = 500) {
  try {
    const res = await wixData.query(coleccion).limit(limite).descending('_createdDate').find(OPTS);
    return res.items || [];
  } catch (e) {
    console.warn('[Gerencia] No se pudo cargar colección ' + coleccion + ':', e.message);
    return [];
  }
}

// ── Carga maestra ────────────────────────────────────────────────────────
export async function obtenerDatosGerencia() {
  await verificarAcceso();
  const [clientes, creditos, usuariosCol, carsRaw, egresos, comisiones, pagos, tareas, aprobaciones] = await Promise.all([
    safeQuery('ALeads', 1000),
    safeQuery('Creditos', 500),
    safeQuery('Usuarios',   200),
    safeQuery('Cars', 500),
    safeQuery('Egresos', 500),
    safeQuery('Comisiones', 500),
    safeQuery('Pagos', 500),
    safeQuery('Tareas', 500),
    safeQuery('AprobacionesConsigna', 200),
  ]);

  // Usuarios es la única fuente de vendedores
  const vendedores = [...usuariosCol];

  // Índice email→_id para resolver vendedorAsignado (email) a _id de Usuarios
  const emailToId = {};
  usuariosCol.forEach(u => { if (u.email) emailToId[u.email.toLowerCase()] = u._id; });

  const carMap = {};
  carsRaw.forEach(car => { carMap[car._id] = car; });

  // Índice leadId→comisión para usar Comisiones como fuente oficial
  const comisionMap = {};
  comisiones.forEach(com => {
    if (com.leadId && !comisionMap[com.leadId]) comisionMap[com.leadId] = com;
  });

  // Enriquecer leads con datos del auto vinculado
  const clientesEnriquecidos = clientes.map(lead => {
    const autoId = lead.cierreAutoId || lead.autoInventarioId || lead.autoInteresId || lead.vehiculoId || '';
    const car = autoId ? carMap[autoId] : null;

    // ── 1.2 Precio canónico ──────────────────────────────────────────────
    const precioVenta = lead.cierrePrecio || lead.precioVenta
      || (car ? (car.precioVenta || car.priceNew || car.precio) : 0) || 0;

    // ── 1.4 Costo canónico con lógica consigna ───────────────────────────
    const costoAdquisicion = (car ? (car.costoAdquisicion || car.costoCompra || car.costo) : null)
      || lead.costoAdquisicion || 0;
    const tipoAdq = car ? (car.tipoAdquisicion || car.tipoOrigen || 'compra').toLowerCase() : 'compra';
    const esConsigna = tipoAdq === 'consigna' || car?.esConsigna === true;
    const costoFinal = esConsigna
      ? parseFloat(car?.precioConvenido || car?.precioConsignaMin || car?.costoConsigna || costoAdquisicion || 0)
      : parseFloat(costoAdquisicion || 0);
    const precioConsignado = esConsigna ? costoFinal : 0;
    const gastoReparacion   = parseFloat((car?.gastoReparacion || car?.gastosReparacion || car?.reparacion) || 0);
    const gastoLegal        = parseFloat((car?.gastoLegalAduanas || car?.gastoLegal) || 0);
    const gastosExtras      = parseFloat((car?.gastosExtras || car?.gastoAdicional) || 0);
    const gastoTotal        = gastoReparacion + gastoLegal + gastosExtras;
    const costoTotal        = costoFinal + gastoTotal;

    // ── 1.7 Comisión: fuente oficial es colección Comisiones ─────────────
    const comisionObj      = comisionMap[lead._id];
    const comisionVendedor = parseFloat(
      (comisionObj?.monto) || lead.cierreComision || lead.comisionVendedor
      || (car?.comisionVendedor) || 0
    );

    // ── 1.6 Etapa canónica (normalizada a mayúscula inicial) ─────────────
    const etapaRaw  = lead.etapa || lead.estatus || lead.status || lead.estado || 'Nuevo';
    const etapaMap  = { nuevo:'Nuevo', contactado:'Contactado', interesado:'Interesado',
                        negociando:'Negociando', ganado:'Ganado', perdido:'Perdido',
                        vendido:'Ganado', entregado:'Ganado' };
    const _etapa    = etapaMap[etapaRaw.toLowerCase()] || etapaRaw;

    // ── 1.3 Estatus del auto normalizado ─────────────────────────────────
    const estatusCarRaw = car ? (car.estatusVenta || car.estatus || car.status || 'disponible') : 'disponible';
    const estatusCarMap = { disponible:'disponible', apartado:'apartado', vendido:'vendido',
                            entregado:'entregado', consigna:'consigna', 'en proceso':'apartado' };
    const _estatusCar   = estatusCarMap[estatusCarRaw.toLowerCase()] || estatusCarRaw.toLowerCase();

    // ── 1.8 vendedorId: resolver email→_id ───────────────────────────────
    const _vendedorId = lead.vendedorId
      || emailToId[(lead.vendedorAsignado || '').toLowerCase()]
      || lead.vendedorAsignado || '';

    return {
      ...lead,
      // Campos canónicos
      _etapa,
      _vendedorId,
      _precioVenta:        parseFloat(precioVenta) || 0,
      _costoAdquisicion:   costoFinal,
      _gastoTotal:         gastoTotal,
      _costoTotal:         costoTotal,
      _comisionVendedor:   comisionVendedor,
      _margenBruto:        parseFloat(precioVenta) > 0
                             ? Math.round((parseFloat(precioVenta) - costoTotal - comisionVendedor)
                               / parseFloat(precioVenta) * 100)
                             : 0,
      _autoNombre: car
        ? [car.marca||car.brand||'', car.modelo||car.model||'', car.año||car.anio||car.year||''].filter(Boolean).join(' ')
        : (lead.autoInteres || ''),
      _esConsigna:         esConsigna,
      _precioConsignado:   precioConsignado,
      _estatusCar,
      // Datos del carro para expediente y rentabilidad
      _car: car ? {
        _id:              car._id,
        _estatusCar,
        _km:              parseFloat(car.km || car.kilometraje || car.mileage || 0),
        _color:           car.color || car.colour || car.colorExterior || '',
        _version:         car.version || car.versión || car.trim || car.variant || '',
        _anio:            car.año || car.anio || car.year || '',
        vin:              car.vin || car.VIN || '',
        fotos:            car.fotos || car.images || [],
        foto:             car.foto || car.fotoPrincipal || car.imagenUrl || '',
        tipoAdquisicion:  car.tipoAdquisicion || car.tipoOrigen || 'compra',
        duenioNombre:     car.duenioNombre || car.propietario || car.nombreDueno || '',
        duenioTel:        car.duenioTelefono || car.telefonoDueno || '',
        precioVenta:      parseFloat(car.precioVenta || car.priceNew || car.precio || 0),
        precioConvenido:  parseFloat(car.precioConvenido || car.precioConsignaMin || car.costoConsigna || 0),
        costoAdquisicion: parseFloat(car.costoAdquisicion || car.costoCompra || car.costo || 0),
        gastoReparacion,
        gastoLegalAduanas: gastoLegal,
        gastosExtras,
        gastoTotal,
        fechaIngreso:     car.fechaIngreso || car.fechaCompra || car._createdDate || null,
      } : null,
    };
  });

  return { clientes: clientesEnriquecidos, creditos, vendedores, cars: carsRaw, egresos, comisiones, pagos, tareas, aprobaciones };
}

// ── Actualizar datos de un lead/cierre ───────────────────────────────────
export async function actualizarDatosLead(leadId, campos) {
  await verificarAcceso();
  try {
    const lead = await wixData.get('ALeads', leadId, OPTS);
    if (!lead) throw new Error('Lead no encontrado');
    const actualizado = await wixData.update('ALeads', { ...lead, ...campos, _id: leadId }, OPTS);
    // Si hay autoId y cambia el precio, actualizar también en Cierres si existe
    const hasCamposCierre = campos.precioVenta || campos.cierrePrecio ||
      campos.cierreComision !== undefined || campos.comisionVendedor !== undefined ||
      campos.formaPago || campos.banco || campos.enganche !== undefined || campos.notas;
    if (hasCamposCierre) {
      try {
        const cierres = await wixData.query('Cierres').eq('leadId', leadId).find(OPTS);
        if (cierres.items.length > 0) {
          const c = cierres.items[0];
          const updates = { ...c };
          if (campos.precioVenta || campos.cierrePrecio) updates.precioVenta = campos.precioVenta || campos.cierrePrecio;
          if (campos.cierreComision !== undefined) updates.comision = campos.cierreComision;
          if (campos.comisionVendedor !== undefined) updates.comisionVendedor = campos.comisionVendedor;
          if (campos.formaPago)  updates.formaPago    = campos.formaPago;
          if (campos.banco)      updates.banco        = campos.banco;
          if (campos.enganche !== undefined) updates.engancheMonto = campos.enganche;
          if (campos.notas)      updates.notas        = campos.notas;
          await wixData.update('Cierres', updates, OPTS);
        }
      } catch (_) {}
    }
    return { ok: true, lead: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Registrar egreso ────────────────────────────────────────────────────
export async function registrarEgreso(datos) {
  await verificarAcceso();
  try {
    const item = {
      concepto:       datos.concepto || '',
      categoria:      datos.categoria || 'Otro',
      monto:          parseFloat(datos.monto) || 0,
      ref:            datos.ref || '',
      notas:          datos.notas || '',
      fecha:          datos.fecha ? new Date(datos.fecha) : new Date(),
      registradoPor:  datos.registradoPor || '',
      _tmp:           datos._tmp || '',
    };
    const inserted = await wixData.insert('Egresos', item, OPTS);
    return { ok: true, egreso: { ...inserted, _tmp: item._tmp } };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar comisión ──────────────────────────────────────────────────
export async function actualizarComision(id, datos) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('Comisiones', id, OPTS);
    if (!existente) throw new Error('Comisión no encontrada');
    const actualizado = await wixData.update('Comisiones', { ...existente, ...datos, _id: id }, OPTS);
    return { ok: true, comision: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar crédito ───────────────────────────────────────────────────
export async function actualizarCredito(id, datos) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('Creditos', id, OPTS);
    if (!existente) throw new Error('Crédito no encontrado');
    const actualizado = await wixData.update('Creditos', { ...existente, ...datos, _id: id }, OPTS);
    // Sincronizar estatus en Cierres si aplica
    if (datos.estatus) {
      try {
        const cierres = await wixData.query('Cierres').eq('creditoId', id).find(OPTS);
        if (cierres.items.length > 0) {
          const c = cierres.items[0];
          await wixData.update('Cierres', { ...c, estatusCredito: datos.estatus }, OPTS);
        }
      } catch (_) {}
    }
    return { ok: true, credito: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Registrar pago / apartado ────────────────────────────────────────────
export async function registrarPago(datos) {
  await verificarAcceso();
  try {
    const item = {
      cliente:       datos.cliente || '',
      clienteId:     datos.clienteId || '',
      leadId:        datos.leadId || '',
      vehiculoId:    datos.vehiculoId || '',
      auto:          datos.auto || '',
      tipo:          datos.tipo || datos.formaPago || 'Contado',
      monto:         parseFloat(datos.monto) || 0,
      notas:         datos.notas || '',
      fecha:         datos.fecha ? new Date(datos.fecha) : new Date(),
      registradoPor: datos.registradoPor || '',
      _tmp:          datos._tmp || '',
    };
    const inserted = await wixData.insert('Pagos', item, OPTS);
    return { ok: true, pago: inserted };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Crear tarea ──────────────────────────────────────────────────────────
export async function crearTarea(datos) {
  await verificarAcceso();
  try {
    const item = {
      titulo:         datos.titulo || '',
      prioridad:      datos.prioridad || 'normal',
      responsableId:  datos.responsableId || '',
      responsableNombre: datos.responsableNombre || '',
      fechaLimite:    datos.fechaLimite ? new Date(datos.fechaLimite) : null,
      categoria:      datos.categoria || '',
      notas:          datos.notas || '',
      estado:         datos.estado || 'pendiente',
      creadoPor:      datos.creadoPor || '',
      _tmp:           datos._tmp || '',
    };
    const inserted = await wixData.insert('Tareas', item, OPTS);
    return { ok: true, tarea: inserted };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar tarea ──────────────────────────────────────────────────────
export async function actualizarTarea(id, datos) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('Tareas', id, OPTS);
    if (!existente) throw new Error('Tarea no encontrada');
    const actualizada = await wixData.update('Tareas', { ...existente, ...datos, _id: id }, OPTS);
    return { ok: true, tarea: actualizada };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Aprobaciones de precio consigna ──────────────────────────────────────
export async function crearSolicitudAprobacion(datos) {
  await verificarAcceso();
  try {
    const item = {
      tipo:             datos.tipo || 'consigna',   // 'consigna' | 'descuento'
      autoId:           datos.autoId || '',
      autoNombre:       datos.autoNombre || '',
      leadId:           datos.leadId || '',
      clienteNombre:    datos.clienteNombre || '',
      precioSolicitado: parseFloat(datos.precioSolicitado) || 0,
      precioAnterior:   parseFloat(datos.precioAnterior) || 0,
      montoDescuento:   parseFloat(datos.montoDescuento) || 0,
      notas:            datos.notas || '',
      solicitadoPor:    datos.solicitadoPor || '',
      fechaSolicitud:   new Date(),
      firmaContraloria:       false,
      firmaContraloriaFecha:  null,
      firmaContraloriaUser:   '',
      firmaGerenciaVentas:    false,
      firmaGerenciaVentasFecha: null,
      firmaGerenciaVentasUser:  '',
      estatus: 'pendiente',
    };
    const inserted = await wixData.insert('AprobacionesConsigna', item, OPTS);
    return { ok: true, aprobacion: inserted };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

export async function firmarAprobacion(id, tipoFirma, usuarioNombre, usuarioEmail) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('AprobacionesConsigna', id, OPTS);
    if (!existente) throw new Error('Aprobación no encontrada');
    const ahora = new Date();
    const update = { ...existente, _id: id };
    if (tipoFirma === 'contraloria') {
      update.firmaContraloria      = true;
      update.firmaContraloriaFecha = ahora;
      update.firmaContraloriaUser  = usuarioNombre || usuarioEmail || '';
    } else if (tipoFirma === 'gerenciaVentas') {
      update.firmaGerenciaVentas       = true;
      update.firmaGerenciaVentasFecha  = ahora;
      update.firmaGerenciaVentasUser   = usuarioNombre || usuarioEmail || '';
    }
    // Si ambas firmas están presentes → aprobar y actualizar precio en Cars
    const ambasFirmas = update.firmaContraloria && update.firmaGerenciaVentas;
    if (ambasFirmas) {
      update.estatus = 'aprobado';
      update.fechaAprobacion = ahora;
      const tipo = existente.tipo || 'consigna';
      if (tipo === 'consigna' && existente.autoId) {
        // Actualizar precio convenido en el auto
        try {
          const car = await wixData.get('Cars', existente.autoId, OPTS);
          if (car) {
            await wixData.update('Cars', {
              ...car,
              precioConvenido:   parseFloat(existente.precioSolicitado),
              precioConsignaMin: parseFloat(existente.precioSolicitado),
              _id: car._id,
            }, OPTS);
          }
        } catch (_) {}
      } else if (tipo === 'descuento' && existente.leadId) {
        // Registrar precio aprobado con descuento en el lead
        try {
          const lead = await wixData.get('ALeads', existente.leadId, OPTS);
          if (lead) {
            await wixData.update('ALeads', {
              ...lead,
              precioConDescuento:    parseFloat(existente.precioSolicitado),
              descuentoAprobado:     parseFloat(existente.montoDescuento),
              descuentoAprobadoPor:  `${existente.firmaContraloriaUser} + ${existente.firmaGerenciaVentasUser}`,
              _id: lead._id,
            }, OPTS);
          }
        } catch (_) {}
      }
    }
    const actualizada = await wixData.update('AprobacionesConsigna', update, OPTS);
    return { ok: true, aprobacion: actualizada, aprobado: ambasFirmas };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

export async function rechazarAprobacion(id, usuarioNombre, notas) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('AprobacionesConsigna', id, OPTS);
    if (!existente) throw new Error('Aprobación no encontrada');
    const actualizada = await wixData.update('AprobacionesConsigna', {
      ...existente, _id: id,
      estatus: 'rechazado',
      notasRechazo: notas || '',
      rechazadoPor: usuarioNombre || '',
      fechaRechazo: new Date(),
    }, OPTS);
    return { ok: true, aprobacion: actualizada };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar metas de vendedores ───────────────────────────────────────
export async function actualizarMetas(vendedoresConMeta) {
  await verificarAcceso();
  try {
    const updates = await Promise.all(
      vendedoresConMeta.map(async ({ id, metaMensual, metaEquipo, bonoMeta }) => {
        try {
          // Intentar en Vendedores primero; si no existe, usar Usuarios
          let existente = null;
          try { existente = await wixData.get('Vendedores', id, OPTS); } catch (_) {}
          if (existente) {
            await wixData.update('Vendedores', { ...existente, metaMensual, metaEquipo, bonoMeta, _id: id }, OPTS);
          } else {
            const usuario = await wixData.get('Usuarios', id, OPTS);
            if (usuario) await wixData.update('Usuarios', { ...usuario, metaMensual, metaEquipo, bonoMeta, _id: id }, OPTS);
          }
          return { id, ok: true };
        } catch (e) { return { id, ok: false, error: e.message }; }
      })
    );
    return { ok: true, updates };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}
