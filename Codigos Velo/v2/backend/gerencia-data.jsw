// backend/gerencia-data.jsw
// Panel Gerencia — vista completa de todas las colecciones
import wixData  from 'wix-data';
import wixUsers from 'wix-users-backend';

const OPTS = { suppressAuth: true };
const ROLES_GERENCIA = ['gerencia', 'administracion'];

async function verificarAcceso() {
  try {
    const user = wixUsers.currentUser;
    if (!user.loggedIn) return; // en preview puede no haber sesión
    const roles = await user.getRoles();
    const nombres = roles.map(r => (r.name || '').toLowerCase());
    if (!ROLES_GERENCIA.some(r => nombres.includes(r)))
      throw new Error('Sin permiso para acceder a datos de Gerencia');
  } catch (e) {
    // "Identity not found" en editor/preview — permitir carga de datos
    if (e.message && e.message.includes('Identity not found')) return;
    throw e;
  }
}

async function safeQuery(coleccion, limite = 500) {
  try {
    const res = await wixData.query(coleccion).limit(limite).descending('_createdDate').find(OPTS);
    return res.items || [];
  } catch (e) {
    console.warn('[Gerencia] No se pudo cargar colección ' + coleccion + ':', e.message);
    return [];
  }
}

// ── Carga maestra ────────────────────────────────────────────────────────
export async function obtenerDatosGerencia() {
  await verificarAcceso();
  const [clientes, creditos, usuariosCol, carsRaw, egresos, comisiones] = await Promise.all([
    safeQuery('ALeads', 1000),
    safeQuery('Creditos', 500),
    safeQuery('Usuarios',   200),
    safeQuery('Cars', 500),
    safeQuery('Egresos', 500),
    safeQuery('Comisiones', 500),
  ]);

  // Usuarios es la única fuente de vendedores
  const vendedores = [...usuariosCol];

  const carMap = {};
  carsRaw.forEach(car => { carMap[car._id] = car; });

  // Enriquecer leads con datos del auto vinculado
  const clientesEnriquecidos = clientes.map(lead => {
    const autoId = lead.cierreAutoId || lead.autoInventarioId || lead.autoInteresId || lead.vehiculoId || '';
    const car = autoId ? carMap[autoId] : null;
    const precioVenta = lead.cierrePrecio || lead.precioVenta
      || (car ? (car.precioVenta || car.priceNew || car.precio) : 0) || 0;
    const costoAdquisicion = (car ? (car.costoAdquisicion || car.costoCompra || car.costo) : null)
      || lead.costoAdquisicion || 0;
    const tipoAdq = car ? (car.tipoAdquisicion || car.tipoOrigen || 'compra').toLowerCase() : 'compra';
    const esConsigna = tipoAdq === 'consigna' || car?.esConsigna === true;
    const costoFinal = esConsigna
      ? parseFloat(car?.precioConsignaMin || car?.costoConsigna || costoAdquisicion || 0)
      : costoAdquisicion;
    const precioConsignado = esConsigna
      ? parseFloat(car?.precioConvenido || car?.precioConsignaMin || car?.costoConsigna || costoAdquisicion || 0)
      : 0;
    return {
      ...lead,
      _precioVenta: precioVenta,
      _costoAdquisicion: costoFinal,
      _comisionVendedor: lead.cierreComision || lead.comisionVendedor || (car ? car.comisionVendedor : 0) || 0,
      _autoNombre: car
        ? [car.marca||car.brand||'', car.modelo||car.model||'', car.anio||car.year||''].filter(Boolean).join(' ')
        : (lead.autoInteres || ''),
      _esConsigna: esConsigna,
      _precioConsignado: precioConsignado,
      // Datos del carro para expediente
      _car: car ? {
        _id: car._id,
        vin: car.vin || car.VIN || '',
        fotos: car.fotos || car.images || [],
        foto: car.foto || car.fotoPrincipal || car.imagenUrl || '',
        tipoAdquisicion: car.tipoAdquisicion || car.tipoOrigen || 'compra',
        duenioNombre: car.duenioNombre || car.propietario || car.nombreDueno || '',
        duenioTel: car.duenioTelefono || car.telefonoDueno || '',
        precioConvenido: car.precioConvenido || car.precioConsignaMin || car.costoConsigna || 0,
        costoAdquisicion: car.costoAdquisicion || car.costoCompra || car.costo || 0,
        gastoReparacion: car.gastoReparacion || car.gastosReparacion || car.reparacion || 0,
        gastoLegalAduanas: car.gastoLegalAduanas || car.gastoLegal || 0,
        gastosExtras: car.gastosExtras || car.gastoAdicional || 0,
      } : null,
    };
  });

  return { clientes: clientesEnriquecidos, creditos, vendedores, cars: carsRaw, egresos, comisiones };
}

// ── Actualizar datos de un lead/cierre ───────────────────────────────────
export async function actualizarDatosLead(leadId, campos) {
  await verificarAcceso();
  try {
    const lead = await wixData.get('ALeads', leadId, OPTS);
    if (!lead) throw new Error('Lead no encontrado');
    const actualizado = await wixData.update('ALeads', { ...lead, ...campos, _id: leadId }, OPTS);
    // Si hay autoId y cambia el precio, actualizar también en Cierres si existe
    const hasCamposCierre = campos.precioVenta || campos.cierrePrecio ||
      campos.cierreComision !== undefined || campos.comisionVendedor !== undefined ||
      campos.formaPago || campos.banco || campos.enganche !== undefined || campos.notas;
    if (hasCamposCierre) {
      try {
        const cierres = await wixData.query('Cierres').eq('leadId', leadId).find(OPTS);
        if (cierres.items.length > 0) {
          const c = cierres.items[0];
          const updates = { ...c };
          if (campos.precioVenta || campos.cierrePrecio) updates.precioVenta = campos.precioVenta || campos.cierrePrecio;
          if (campos.cierreComision !== undefined) updates.comision = campos.cierreComision;
          if (campos.comisionVendedor !== undefined) updates.comisionVendedor = campos.comisionVendedor;
          if (campos.formaPago)  updates.formaPago    = campos.formaPago;
          if (campos.banco)      updates.banco        = campos.banco;
          if (campos.enganche !== undefined) updates.engancheMonto = campos.enganche;
          if (campos.notas)      updates.notas        = campos.notas;
          await wixData.update('Cierres', updates, OPTS);
        }
      } catch (_) {}
    }
    return { ok: true, lead: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Registrar egreso ────────────────────────────────────────────────────
export async function registrarEgreso(datos) {
  await verificarAcceso();
  try {
    const item = {
      concepto:       datos.concepto || '',
      categoria:      datos.categoria || 'Otro',
      monto:          parseFloat(datos.monto) || 0,
      ref:            datos.ref || '',
      notas:          datos.notas || '',
      fecha:          datos.fecha ? new Date(datos.fecha) : new Date(),
      registradoPor:  datos.registradoPor || '',
    };
    const inserted = await wixData.insert('Egresos', item, OPTS);
    return { ok: true, egreso: inserted };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar comisión ──────────────────────────────────────────────────
export async function actualizarComision(id, datos) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('Comisiones', id, OPTS);
    if (!existente) throw new Error('Comisión no encontrada');
    const actualizado = await wixData.update('Comisiones', { ...existente, ...datos, _id: id }, OPTS);
    return { ok: true, comision: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar crédito ───────────────────────────────────────────────────
export async function actualizarCredito(id, datos) {
  await verificarAcceso();
  try {
    const existente = await wixData.get('Creditos', id, OPTS);
    if (!existente) throw new Error('Crédito no encontrado');
    const actualizado = await wixData.update('Creditos', { ...existente, ...datos, _id: id }, OPTS);
    // Sincronizar estatus en Cierres si aplica
    if (datos.estatus) {
      try {
        const cierres = await wixData.query('Cierres').eq('creditoId', id).find(OPTS);
        if (cierres.items.length > 0) {
          const c = cierres.items[0];
          await wixData.update('Cierres', { ...c, estatusCredito: datos.estatus }, OPTS);
        }
      } catch (_) {}
    }
    return { ok: true, credito: actualizado };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}

// ── Actualizar metas de vendedores ───────────────────────────────────────
export async function actualizarMetas(vendedoresConMeta) {
  await verificarAcceso();
  try {
    const updates = await Promise.all(
      vendedoresConMeta.map(async ({ id, metaMensual, metaEquipo, bonoMeta }) => {
        try {
          // Intentar en Vendedores primero; si no existe, usar Usuarios
          let existente = null;
          try { existente = await wixData.get('Vendedores', id, OPTS); } catch (_) {}
          if (existente) {
            await wixData.update('Vendedores', { ...existente, metaMensual, metaEquipo, bonoMeta, _id: id }, OPTS);
          } else {
            const usuario = await wixData.get('Usuarios', id, OPTS);
            if (usuario) await wixData.update('Usuarios', { ...usuario, metaMensual, metaEquipo, bonoMeta, _id: id }, OPTS);
          }
          return { id, ok: true };
        } catch (e) { return { id, ok: false, error: e.message }; }
      })
    );
    return { ok: true, updates };
  } catch (e) {
    return { ok: false, error: e.message };
  }
}
